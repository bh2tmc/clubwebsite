<!DOCTYPE HTML>
<html lang="en">
  <head>
    <title>{{ title }} | {{ site.clubShort }}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <meta name="description" content="{{ description or 'Braddell Heights II Toastmasters — Singapore public speaking and leadership club since 1998. Overcome stage fright, speak confidently, and grow as a leader.' }}" />
    <link rel="canonical" href="https://bh2tmc.pages.dev{{ page.url }}" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.clubName }}" />
    <meta property="og:title" content="{{ title }} | {{ site.clubShort }}" />
    <meta property="og:description" content="{{ description or 'Braddell Heights II Toastmasters — Singapore public speaking and leadership club since 1998. Overcome stage fright, speak confidently, and grow as a leader.' }}" />
    <meta property="og:url" content="https://bh2tmc.pages.dev{{ page.url }}" />
    <meta property="og:image" content="https://bh2tmc.pages.dev/images/og-cover.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title }} | {{ site.clubShort }}" />
    <meta name="twitter:description" content="{{ description or 'Braddell Heights II Toastmasters — Singapore public speaking and leadership club since 1998. Overcome stage fright, speak confidently, and grow as a leader.' }}" />
    <meta name="twitter:image" content="https://bh2tmc.pages.dev/images/og-cover.jpg" />

    <!-- LocalBusiness structured data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SportsActivityLocation",
      "name": "Braddell Heights II Toastmasters Club",
      "alternateName": ["BH II Toastmasters", "BH2 Toastmasters"],
      "url": "https://bh2tmc.pages.dev",
      "logo": "https://bh2tmc.pages.dev/images/logos/bh2-logo.png",
      "image": "https://bh2tmc.pages.dev/images/og-cover.jpg",
      "description": "Award-winning Singapore public speaking and leadership club since 1998. Overcome stage fright, speak confidently, and develop leadership skills through our fortnightly Toastmasters meetings.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1 Braddell Rise, Level 3, Classroom 4 (#03-12)",
        "addressLocality": "Singapore",
        "postalCode": "579716",
        "addressCountry": "SG"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 1.3474,
        "longitude": 103.8707
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": "Saturday",
        "opens": "13:45",
        "closes": "16:30"
      },
      "email": "bh2tmc@gmail.com",
      "foundingDate": "1998",
      "memberOf": {
        "@type": "Organization",
        "name": "Toastmasters International",
        "url": "https://www.toastmasters.org"
      },
      "sameAs": [
        "https://www.instagram.com/braddellheightsii/",
        "https://www.facebook.com/braddellheightsII",
        "https://www.linkedin.com/in/braddell-heights-ii-toastmasters-club/"
      ],
      "keywords": "toastmasters singapore, public speaking singapore, overcome stage fright, speak confidently, leadership workshop singapore, communication skills singapore"
    }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Source+Sans+3:wght@300;400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Source+Sans+3:wght@300;400;600&display=swap" rel="stylesheet" /></noscript>
    <link rel="stylesheet" href="/assets/css/main.css" />
    <noscript><link rel="stylesheet" href="/assets/css/noscript.css" /></noscript>
  </head>
  <body class="is-preload">
    <div id="page-wrapper">

      <header id="header" class="{{ headerClass or '' }}">
        {% if headerClass != 'alt' %}
        <h1>
          <a href="/" style="display:inline-flex;align-items:center;gap:0.5rem;text-decoration:none;">
            <img src="/images/logos/bh2-logo.png" alt="" style="height:28px;width:auto;vertical-align:middle;display:inline;" />{{ site.clubShort }}
          </a>
        </h1>
        {% endif %}
        <nav><a href="#menu">Menu</a></nav>
      </header>

      <nav id="menu">
        <div class="inner">
          <h2>Menu</h2>
          <ul class="links">
            <li><a href="/">Home</a></li>
            <li><a href="/what-is-toastmasters/">What is Toastmasters?</a></li>
            <li><a href="/experience/">The BH II Experience</a></li>
            <li><a href="/gallery/">Gallery</a></li>
            <li><a href="/achievements/">Achievements</a></li>
            <li><a href="/faq/">FAQ</a></li>
            <li><a href="/join/">Join Us</a></li>
          </ul>
          <a href="#" class="close">Close</a>
        </div>
      </nav>

      {{ content | safe }}

      <section id="footer">
        <div class="inner">
          {% block footerContent %}
          <ul class="contact">
            <li class="icon solid fa-home">{{ site.venue }}<br />{{ site.address }}</li>
            <li class="icon solid fa-calendar">{{ site.meetingSchedule }}</li>
            <li class="icon solid fa-envelope"><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
            <li class="icon brands fa-instagram"><a href="{{ site.instagram }}" target="_blank">Instagram</a></li>
            <li class="icon brands fa-facebook-f"><a href="{{ site.facebook }}" target="_blank">Facebook</a></li>
            <li class="icon brands fa-linkedin"><a href="{{ site.linkedin }}" target="_blank">LinkedIn</a></li>
          </ul>
          {% endblock %}
          <div style="display:flex;align-items:center;gap:1.5rem;margin:1.5rem 0 1rem;">
            <img src="/images/logos/tm-international-logo.png" alt="Toastmasters International" style="height:3.9rem;width:auto;opacity:0.8;" />
            <img src="/images/logos/bh2-logo.png" alt="Braddell Heights II Toastmasters" style="height:5.1rem;width:auto;opacity:0.8;" />
          </div>
          <ul class="copyright">
            <li>&copy; {{ site.clubName }}. All rights reserved.</li>
            <li>Design: <a href="http://html5up.net">HTML5 UP</a></li>
          </ul>
          <p style="font-size:0.75rem; color:rgba(255,255,255,0.4); margin-top:1rem;">This website is maintained by Braddell Heights II Toastmasters Club, a member club of Toastmasters International. Toastmasters International does not endorse or take responsibility for the content of member club websites.</p>
        </div>
      </section>

    </div>
    <script src="/assets/js/jquery.min.js"></script>
    <script src="/assets/js/jquery.scrollex.min.js"></script>
    <script src="/assets/js/browser.min.js"></script>
    <script src="/assets/js/breakpoints.min.js"></script>
    <script src="/assets/js/util.js"></script>
    <script src="/assets/js/main.js"></script>
  </body>
</html>
