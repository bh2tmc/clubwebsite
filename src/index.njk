<script>
(function() {
  function nextMeeting() {
    var now = new Date();
    var d = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    if (d.getDay() === 6 && now.getHours() >= 17) { d.setDate(d.getDate() + 1); }
    var daysUntilSat = (6 - d.getDay() + 7) % 7;
    d.setDate(d.getDate() + daysUntilSat);
    for (var i = 0; i < 6; i++) {
      var week = Math.ceil(d.getDate() / 7);
      if (week === 2 || week === 4) return d;
      d.setDate(d.getDate() + 7);
    }
    return d;
  }

  function pad(n) { return n < 10 ? '0' + n : '' + n; }

  function generateICS(d) {
    var dateStr = d.getFullYear() + '' + pad(d.getMonth() + 1) + '' + pad(d.getDate());
    return [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//BH II Toastmasters//bh2tmc.pages.dev//EN',
      'BEGIN:VEVENT',
      'DTSTART:' + dateStr + 'T054500Z',
      'DTEND:' + dateStr + 'T083000Z',
      'SUMMARY:BH II Toastmasters Meeting',
      'DESCRIPTION:You are warmly invited to join us as a guest. No registration needed\, no pressure to speak. Just turn up and see what we are about.\n\nhttps://bh2tmc.pages.dev/join/',
      'LOCATION:Braddell Heights Community Centre\, Level 3\, Classroom 4 (#03-12)\, 1 Braddell Rise\, Singapore 579716',
      'URL:https://bh2tmc.pages.dev/join/',
      'END:VEVENT',
      'END:VCALENDAR'
    ].join('\r\n');
  }

  function downloadICS(d) {
    var blob = new Blob([generateICS(d)], { type: 'text/calendar;charset=utf-8' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'bh2-toastmasters-meeting.ics';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  var d = nextMeeting();
  var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  var el = document.getElementById('next-meeting-pill');
  if (el) {
    el.innerHTML =
      '▶ Next meeting: Sat ' + d.getDate() + ' ' + months[d.getMonth()] + ', 1:45 pm' +
      '  <a href="#" id="add-to-cal" style="color:#F2DF74;font-size:0.9em;opacity:0.8;text-decoration:underline;letter-spacing:0.06em;">+ Add to calendar</a>';
    document.getElementById('add-to-cal').addEventListener('click', function(e) {
      e.preventDefault();
      downloadICS(d);
    });
  }
})();
</script>

